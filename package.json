{
  "name": "space-extension-store",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run releases && vite --host 127.0.0.1 --port 5173 --strictPort",
    "releases": "node scripts/build-releases.mjs",
