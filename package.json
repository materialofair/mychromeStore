    "check": "tsc --noEmit"
  },
  "dependencies": {
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "^22.0.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
