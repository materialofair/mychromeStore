{
  "manifest_version": 3,
  "name": "Focus Notes · 专注便签",
  "version": "1.0.0",
  "description": "本地便签与 Space 扩展商店更新演示。",
  "key": "",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Focus Notes"
  },
  "externally_connectable": {
    "matches": [
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  }
}
